<Window x:Class="MomotalkAutoJP.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ui.s.title}"
        Width="500" Height="640" MinWidth="420" MinHeight="420"
        FontSize="{DynamicResource BaseFontSize}"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="12,12,12,0">
            <StackPanel>

                <!-- 화면 (언어 / 글자 크기) -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource ui.s.secView}"/>
                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource ui.s.language}"/>
                        <WrapPanel>
                            <RadioButton x:Name="LangKo" Content="한국어" GroupName="lang" Checked="Lang_Checked"/>
                            <RadioButton x:Name="LangJa" Content="日本語" GroupName="lang" Checked="Lang_Checked"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource ui.s.font}"/>
                        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource ui.s.fontDesc}"/>
                        <WrapPanel>
                            <RadioButton x:Name="FontNormal" Content="{DynamicResource ui.s.fontNormal}" GroupName="font" Checked="Font_Checked"/>
                            <RadioButton x:Name="FontLarge" Content="{DynamicResource ui.s.fontLarge}" GroupName="font" Checked="Font_Checked"/>
                            <RadioButton x:Name="FontXLarge" Content="{DynamicResource ui.s.fontXLarge}" GroupName="font" Checked="Font_Checked"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 해상도 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource ui.s.secRes}"/>
                        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource ui.s.resDesc}"/>
                        <ComboBox x:Name="ResolutionCombo" Margin="0,4,0,0" SelectionChanged="ResolutionCombo_SelectionChanged"/>
                        <Grid x:Name="CustomPanel" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WidthBox" Grid.Column="0" TextChanged="Size_TextChanged"/>
                            <TextBlock Grid.Column="1" Text=" x " VerticalAlignment="Center" FontWeight="Bold" Margin="6,0"/>
                            <TextBox x:Name="HeightBox" Grid.Column="2" TextChanged="Size_TextChanged"/>
                        </Grid>
                        <Button Content="{DynamicResource ui.s.fill}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Click="FillFromWindow_Click"/>
                    </StackPanel>
                </Border>

                <!-- 입력 방식 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource ui.s.secInput}"/>
                        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource ui.s.inputDesc}"/>
                        <WrapPanel>
                            <RadioButton x:Name="InputMouse" Content="{DynamicResource ui.s.inputMouse}" GroupName="input" Checked="Input_Checked"/>
                            <RadioButton x:Name="InputKeyboard" Content="{DynamicResource ui.s.inputKeyboard}" GroupName="input" Checked="Input_Checked"/>
                        </WrapPanel>
                        <StackPanel x:Name="KeysArea">
                            <TextBlock Style="{StaticResource Desc}" Margin="0,8,0,4" Text="{DynamicResource ui.s.keysDesc}"/>
                            <Grid x:Name="KeysGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 게임 창 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource ui.s.secWindow}"/>
                        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource ui.s.windowDesc}"/>
                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource ui.s.windowTitle}"/>
                        <TextBox x:Name="TitleBox"/>
                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource ui.s.windowPick}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="WindowCombo" Grid.Column="0" SelectionChanged="WindowCombo_SelectionChanged"/>
                            <Button Grid.Column="1" Content="{DynamicResource ui.s.refresh}" Margin="6,0,0,0" Click="RefreshWindows_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 인식 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource ui.s.secDetect}"/>

                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource ui.s.threshold}"/>
                        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource ui.s.thresholdDesc}"/>
                        <DockPanel>
                            <TextBlock x:Name="ThresholdText" DockPanel.Dock="Right" Width="52" TextAlignment="Right" FontWeight="Bold"/>
                            <Slider x:Name="ThresholdSlider" Minimum="0.70" Maximum="0.99" TickFrequency="0.01"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource ui.s.badge}"/>
                        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource ui.s.badgeDesc}"/>
                        <DockPanel>
                            <TextBlock x:Name="BadgeText" DockPanel.Dock="Right" Width="52" TextAlignment="Right" FontWeight="Bold"/>
                            <Slider x:Name="BadgeSlider" Minimum="0.60" Maximum="0.99" TickFrequency="0.01"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource ui.s.capture}"/>
                        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource ui.s.captureDesc}"/>
                        <WrapPanel>
                            <RadioButton x:Name="CapturePrint" Content="{DynamicResource ui.s.capturePrint}" GroupName="cap"/>
                            <RadioButton x:Name="CaptureScreen" Content="{DynamicResource ui.s.captureScreen}" GroupName="cap"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 동작 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource ui.s.secAction}"/>

                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource ui.s.delay}"/>
                        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource ui.s.delayDesc}"/>
                        <TextBox x:Name="DelayBox"/>

                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource ui.s.timeout}"/>
                        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource ui.s.timeoutDesc}"/>
                        <TextBox x:Name="TimeoutBox"/>

                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource ui.s.idle}"/>
                        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource ui.s.idleDesc}"/>
                        <TextBox x:Name="IdleBox"/>

                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource ui.s.reply}"/>
                        <TextBlock x:Name="ReplyDesc" Style="{StaticResource Desc}"/>
                        <TextBox x:Name="ReplyBox"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{DynamicResource ui.s.default}" Click="Default_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource ui.s.cancel}" Click="Cancel_Click" MinWidth="90"/>
                    <Button Content="{DynamicResource ui.s.save}" Style="{StaticResource PrimaryButton}" Click="Save_Click" MinWidth="90"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
