<Window x:Class="MomotalkAutoJP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ui.appTitle}"
        Width="380" Height="520" MinWidth="330" MinHeight="420"
        FontSize="{DynamicResource BaseFontSize}"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        Icon="/app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="{DynamicResource ui.appTitle}" FontWeight="Bold" FontSize="19" Foreground="{StaticResource Pink}"/>
                <TextBlock x:Name="WindowStatus" Style="{StaticResource Desc}" Margin="0,6,0,0"/>
                <TextBlock x:Name="ResolutionStatus" Style="{StaticResource Desc}" Margin="0"/>
                <TextBlock x:Name="ModeStatus" Style="{StaticResource Desc}" Margin="0"/>
                <TextBlock x:Name="TemplateStatus" Style="{StaticResource Desc}" Margin="0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1" Columns="3" Margin="-3,0,-3,6">
            <Button x:Name="CheckButton" Content="{DynamicResource ui.check}" Click="Check_Click"/>
            <Button x:Name="TemplateButton" Content="{DynamicResource ui.templates}" Click="Template_Click"/>
            <Button x:Name="SettingsButton" Content="{DynamicResource ui.settings}" Click="Settings_Click"/>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="4">
            <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <UniformGrid Grid.Row="3" Columns="2" Margin="-3,0,-3,0">
            <Button x:Name="StartButton" Content="{DynamicResource ui.start}" Style="{StaticResource PinkButton}"
                    Padding="12,11" FontSize="18" Click="Start_Click"/>
            <Button x:Name="StopButton" Content="{DynamicResource ui.stop}" Style="{StaticResource DangerButton}"
                    Padding="12,11" FontSize="18" Click="Stop_Click" IsEnabled="False"/>
        </UniformGrid>
    </Grid>
</Window>
