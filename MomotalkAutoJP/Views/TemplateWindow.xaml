<Window x:Class="MomotalkAutoJP.Views.TemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ui.t.title}"
        Width="920" Height="600" MinWidth="700" MinHeight="460"
        FontSize="{DynamicResource BaseFontSize}"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 항목 목록 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="4" Margin="0,0,10,0">
            <ListBox x:Name="ItemList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="ItemList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 설명 + 현재 이미지 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="#3A3F46" CornerRadius="6" Padding="4" Margin="10,0,0,0"
                            VerticalAlignment="Top">
                        <Image x:Name="PreviewImage" MaxHeight="70" MaxWidth="200" Stretch="Uniform"/>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="NameText" FontWeight="Bold"/>
                        <TextBlock x:Name="HintText" Style="{StaticResource Desc}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Pink}" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 버튼 -->
            <WrapPanel Grid.Row="1" Margin="-3,0,-3,6">
                <Button Content="{DynamicResource ui.t.refresh}" Click="Refresh_Click"/>
                <Button Content="{DynamicResource ui.t.save}" Style="{StaticResource PinkButton}" Click="Save_Click"/>
                <Button Content="{DynamicResource ui.t.test}" Style="{StaticResource PrimaryButton}" Click="Test_Click"/>
                <Button Content="{DynamicResource ui.t.delete}" Click="Delete_Click"/>
                <Button Content="{DynamicResource ui.t.folder}" Click="Folder_Click"/>
            </WrapPanel>

            <!-- 게임 화면: 드래그해서 영역 선택 -->
            <Border Grid.Row="2" Background="#22262B" CornerRadius="8">
                <Viewbox Stretch="Uniform">
                    <Grid x:Name="ShotGrid" Width="1920" Height="1080">
                        <Image x:Name="ShotImage" Stretch="Fill"/>
                        <Canvas x:Name="Overlay" Background="Transparent" Cursor="Cross"
                                MouseLeftButtonDown="Overlay_MouseDown"
                                MouseMove="Overlay_MouseMove"
                                MouseLeftButtonUp="Overlay_MouseUp">
                            <Rectangle x:Name="SelRect" Stroke="#F06B8C" StrokeThickness="3" Fill="#33F06B8C" Visibility="Collapsed"/>
                            <Rectangle x:Name="HitRect" Stroke="#1E9E5A" StrokeThickness="4" StrokeDashArray="3 2" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Border>

            <TextBlock Grid.Row="3" Style="{StaticResource Desc}" Margin="2,8,0,0" Text="{DynamicResource ui.t.steps}"/>
        </Grid>
    </Grid>
</Window>
